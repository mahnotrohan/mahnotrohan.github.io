---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.title }}</title>
    <description>Essays and notes on attention, time, people and doing things well.</description>
    <link>{{ site.url }}{{ site.baseurl }}/</link>
    <atom:link href="{{ site.url }}{{ site.baseurl }}/feed.xml" rel="self" type="application/rss+xml"/>
    <language>en</language>
    {%- assign notes = site.notes | sort: "date" | reverse -%}
    {%- if notes.first %}<lastBuildDate>{{ notes.first.date | date_to_rfc822 }}</lastBuildDate>{% endif %}
    {%- for note in notes limit: 30 -%}
    {%- unless note.noindex -%}
    <item>
      <title>{{ note.title | xml_escape }}</title>
      <link>{{ site.url }}{{ note.url }}</link>
      <guid isPermaLink="true">{{ site.url }}{{ note.url }}</guid>
      <pubDate>{{ note.date | date_to_rfc822 }}</pubDate>
      {%- if note.description %}<description>{{ note.description | xml_escape }}</description>{% endif -%}
      {%- for t in note.tags %}<category>{{ t | xml_escape }}</category>{% endfor -%}
    </item>
    {%- endunless -%}
    {%- endfor -%}
  </channel>
</rss>
